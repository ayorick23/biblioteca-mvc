@model List<BibliotecaMVC.Models.Autor>

@{
    ViewData["Title"] = "Autores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Gestión de Autores</h1>
        <p class="text-muted mb-0">Consulte, agregue, edite o elimine los autores de los libros.</p>
    </div>
    <a asp-controller="Autores" asp-action="Crear" class="btn btn-primary">+ Agregar autor</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Todavía no hay autores registrados. Use el botón "Agregar autor" para crear el primero.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Nacionalidad</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var autor in Model)
                    {
                        <tr>
                            <td>@autor.Nombres</td>
                            <td>@autor.Apellidos</td>
                            <td><span class="badge bg-secondary">@autor.Nacionalidad</span></td>
                            <td class="text-end">
                                <a asp-controller="Autores" asp-action="Detalle" asp-route-id="@autor.Id" class="btn btn-sm btn-outline-secondary">Ver detalle</a>
                                <a asp-controller="Autores" asp-action="Editar" asp-route-id="@autor.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <form asp-controller="Autores" asp-action="Eliminar" asp-route-id="@autor.Id" method="post" class="d-inline"
                                      data-confirmar="Se eliminará el autor: @autor.Nombres @autor.Apellidos. Esta acción no se puede deshacer." data-tipo="eliminar">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted mt-2">Total de autores: @Model.Count</p>
}
