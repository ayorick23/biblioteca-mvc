@model BibliotecaMVC.Models.Libro

@{
    ViewData["Title"] = "Agregar libro";
    var categorias = (List<BibliotecaMVC.Models.Categoria>)ViewBag.Categorias;
}

<h1>Agregar libro</h1>
<p class="text-muted">Complete el formulario para registrar un nuevo libro en la biblioteca.</p>

<div class="card">
    <div class="card-body">
        <form asp-controller="Libros" asp-action="Crear" method="post" data-confirmar="Se guardará la información ingresada.">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo" class="form-control" placeholder="Ej: Cien años de soledad" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Autor" class="form-label"></label>
                <input asp-for="Autor" class="form-control" placeholder="Ej: Gabriel García Márquez" />
                <span asp-validation-for="Autor" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CategoriaId" class="form-label"></label>
                <select asp-for="CategoriaId" class="form-select">
                    <option value="">-- Seleccione una categoría --</option>
                    @foreach (var categoria in categorias)
                    {
                        <option value="@categoria.Id">@categoria.Nombre</option>
                    }
                </select>
                <span asp-validation-for="CategoriaId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Anio" class="form-label"></label>
                <input asp-for="Anio" class="form-control" placeholder="Ej: 1967" />
                <span asp-validation-for="Anio" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-controller="Libros" asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
