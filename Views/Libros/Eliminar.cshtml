@model BibliotecaMVC.Models.Libro

@{
    ViewData["Title"] = "Eliminar libro";
}

<h1>Eliminar libro</h1>

<p>¿Está seguro de que desea eliminar el siguiente libro?</p>

<dl class="row">
    <dt class="col-sm-2">Título</dt>
    <dd class="col-sm-10">@Model.Titulo</dd>
    <dt class="col-sm-2">Autor</dt>
    <dd class="col-sm-10">@Model.Autor</dd>
    <dt class="col-sm-2">Categoría</dt>
    <dd class="col-sm-10">@Model.CategoriaNombre</dd>
    <dt class="col-sm-2">Año</dt>
    <dd class="col-sm-10">@Model.Anio</dd>
</dl>

<form asp-controller="Libros" asp-action="EliminarConfirmado" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-controller="Libros" asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
