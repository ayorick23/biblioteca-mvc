@model BibliotecaMVC.Models.Libro

@{
    ViewData["Title"] = "Detalle del libro";
}

<h1>Detalle del libro</h1>
<p class="text-muted">Información registrada del libro.</p>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">Título</dt>
            <dd class="col-sm-10">@Model.Titulo</dd>
            <dt class="col-sm-2">Autor</dt>
            <dd class="col-sm-10">@Model.Autor</dd>
            <dt class="col-sm-2">Categoría</dt>
            <dd class="col-sm-10"><span class="badge bg-secondary">@Model.CategoriaNombre</span></dd>
            <dt class="col-sm-2">Año</dt>
            <dd class="col-sm-10">@(Model.Anio?.ToString() ?? "-")</dd>
        </dl>
    </div>
</div>

<a asp-controller="Libros" asp-action="Index" class="btn btn-secondary mt-3">Volver al listado</a>
@* Semana 13: solo Admin y Bibliotecario ven la opción de editar *@
@if (User.IsInRole("Admin") || User.IsInRole("Bibliotecario"))
{
    <a asp-controller="Libros" asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary mt-3">Editar</a>
}
