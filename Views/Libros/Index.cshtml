@model List<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Libros";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Gestión de Libros</h1>
        <p class="text-muted mb-0">Consulte, agregue, edite o elimine los libros de la biblioteca.</p>
    </div>
    <a asp-controller="Libros" asp-action="Crear" class="btn btn-primary">+ Agregar libro</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Todavía no hay libros registrados. Use el botón "Agregar libro" para crear el primero.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Título</th>
                        <th>Autor</th>
                        <th>Categoría</th>
                        <th>Año</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var libro in Model)
                    {
                        <tr>
                            <td>@libro.Titulo</td>
                            <td>@libro.Autor</td>
                            <td><span class="badge bg-secondary">@libro.CategoriaNombre</span></td>
                            <td>@(libro.Anio?.ToString() ?? "-")</td>
                            <td class="text-end">
                                <a asp-controller="Libros" asp-action="Editar" asp-route-id="@libro.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <form asp-controller="Libros" asp-action="Eliminar" asp-route-id="@libro.Id" method="post" class="d-inline"
                                      data-confirmar="Se eliminará el libro: @libro.Titulo. Esta acción no se puede deshacer." data-tipo="eliminar">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted mt-2">Total de libros: @Model.Count</p>
}
