@model BibliotecaMVC.Models.Libro

@{
    ViewData["Title"] = "Editar libro";
    var categorias = (List<BibliotecaMVC.Models.Categoria>)ViewBag.Categorias;
}

<h1>Editar libro</h1>

<form asp-controller="Libros" asp-action="Editar" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label">Título</label>
        <input asp-for="Titulo" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Autor" class="form-label">Autor</label>
        <input asp-for="Autor" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label">Categoría</label>
        <select asp-for="CategoriaId" class="form-select">
            @foreach (var categoria in categorias)
            {
                <option value="@categoria.Id" selected="@(categoria.Id == Model.CategoriaId)">@categoria.Nombre</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Anio" class="form-label">Año</label>
        <input asp-for="Anio" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-controller="Libros" asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
