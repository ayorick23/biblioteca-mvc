@model BibliotecaMVC.Models.Categoria

@{
    ViewData["Title"] = "Agregar categoría";
}

<h1>Agregar categoría</h1>
<p class="text-muted">Complete el formulario para registrar una nueva categoría.</p>

<div class="card">
    <div class="card-body">
        <form asp-controller="Categorias" asp-action="Crear" method="post" data-confirmar="Se guardará la información ingresada.">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Novela" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Ej: Obras narrativas de ficción"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-controller="Categorias" asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
