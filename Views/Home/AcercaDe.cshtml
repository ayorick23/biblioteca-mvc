@{
    ViewData["Title"] = "Acerca de";
}

<article class="about-page">
    <header class="about-header">
        <h1>Acerca de la Biblioteca Virtual</h1>
        <p>Conectando lectores con el conocimiento desde cualquier lugar.</p>
    </header>

    <section class="about-section">
        <h2>Nuestra Misión</h2>
        <p>
            La Biblioteca Virtual UEES tiene como misión facilitar el acceso al conocimiento,
            promoviendo la lectura y la investigación mediante un catálogo digital de libros,
            autores y categorías disponible para toda la comunidad estudiantil.
        </p>
    </section>

    <section class="about-section">
        <h2>Servicios que Ofrecemos</h2>
        <ul class="about-list">
            <li>Consulta del catálogo de libros disponibles</li>
            <li>Información sobre autores y sus obras</li>
            <li>Organización de libros por categorías</li>
            <li>Gestión y seguimiento de préstamos</li>
        </ul>
    </section>

    <aside class="about-aside">
        <h2>Datos Rápidos</h2>
        <p><strong>Horario:</strong> Lunes a Viernes, 8:00 am - 6:00 pm</p>
        <p><strong>Ubicación:</strong> Campus UEES</p>
        <p><strong>Contacto:</strong> biblioteca@uees.edu.ec</p>
    </aside>

    <footer class="about-footer">
        <p>Gracias por ser parte de nuestra comunidad de lectores.</p>
    </footer>
</article>
