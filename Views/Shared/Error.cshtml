@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

@* Semana 15 - Actividad 2: página de error personalizada, sin mostrar detalles técnicos *@
<div class="mensaje-page">
    <div class="card mensaje-card">
        <div class="mensaje-header mensaje-error">
            <div class="mensaje-icon">⚠️</div>
            <h1>¡Ups! Algo salió mal</h1>
            <p>Ocurrió un problema inesperado al procesar su solicitud.</p>
        </div>
        <div class="card-body text-center p-4">
            <p class="mb-2">
                No se preocupe, sus datos están seguros. Ya registramos el problema para revisarlo.
            </p>
            <p class="text-muted mb-0">
                Puede volver al inicio o seguir navegando por las secciones de la biblioteca.
            </p>

            <partial name="_BotonesNavegacion" />
        </div>
    </div>
</div>
