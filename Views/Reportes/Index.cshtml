@model List<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Reportes";
    var autores = (List<string>)ViewBag.Autores;
    var categorias = (List<BibliotecaMVC.Models.Categoria>)ViewBag.Categorias;
    var autorSeleccionado = ViewBag.Autor as string;
    var categoriaSeleccionada = ViewBag.CategoriaId as int?;
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" asp-action="Index">Libros</a></li>
    <li class="nav-item"><a class="nav-link" asp-action="Autores">Autores</a></li>
</ul>

<h1>Reportes de Libros</h1>
<p class="text-muted">Filtre los libros y descargue el reporte en PDF o Excel.</p>

@* Un solo formulario: cada botón envía los mismos filtros a una acción distinta *@
<form method="get" class="card card-body mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label for="autor" class="form-label">Autor</label>
            <select id="autor" name="autor" class="form-select">
                <option value="">Todos</option>
                @foreach (var autor in autores)
                {
                    <option value="@autor" selected="@(autor == autorSeleccionado)">@autor</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label for="categoriaId" class="form-label">Categoría</label>
            <select id="categoriaId" name="categoriaId" class="form-select">
                <option value="">Todas</option>
                @foreach (var categoria in categorias)
                {
                    <option value="@categoria.Id" selected="@(categoria.Id == categoriaSeleccionada)">@categoria.Nombre</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <button type="submit" asp-action="Index" class="btn btn-outline-secondary">Filtrar</button>
            <a asp-action="Index" class="btn btn-link">Limpiar</a>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" asp-action="Pdf" class="btn btn-danger">Generar reporte PDF</button>
        <button type="submit" asp-action="Excel" class="btn btn-success">Exportar a Excel</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay libros que coincidan con los filtros.</div>
}
else
{
    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nombre del libro</th>
                        <th>Autor</th>
                        <th>Categoría</th>
                        <th>Año</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var libro in Model)
                    {
                        <tr>
                            <td>@libro.Id</td>
                            <td>@libro.Titulo</td>
                            <td>@libro.Autor</td>
                            <td><span class="badge bg-secondary">@libro.CategoriaNombre</span></td>
                            <td>@(libro.Anio?.ToString() ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
<p class="text-muted mt-2">Total de libros: @Model.Count</p>
