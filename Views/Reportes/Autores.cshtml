@model List<BibliotecaMVC.Models.Autor>

@{
    ViewData["Title"] = "Reportes";
    var nacionalidades = (List<string>)ViewBag.Nacionalidades;
    var nacionalidadSeleccionada = ViewBag.Nacionalidad as string;
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link" asp-action="Index">Libros</a></li>
    <li class="nav-item"><a class="nav-link active" asp-action="Autores">Autores</a></li>
</ul>

<h1>Reportes de Autores</h1>
<p class="text-muted">Filtre los autores y descargue el reporte en PDF o Excel.</p>

@* Un solo formulario: cada botón envía el mismo filtro a una acción distinta *@
<form method="get" class="card card-body mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label for="nacionalidad" class="form-label">Nacionalidad</label>
            <select id="nacionalidad" name="nacionalidad" class="form-select">
                <option value="">Todas</option>
                @foreach (var nacionalidad in nacionalidades)
                {
                    <option value="@nacionalidad" selected="@(nacionalidad == nacionalidadSeleccionada)">@nacionalidad</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <button type="submit" asp-action="Autores" class="btn btn-outline-secondary">Filtrar</button>
            <a asp-action="Autores" class="btn btn-link">Limpiar</a>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" asp-action="AutoresPdf" class="btn btn-danger">Generar reporte PDF</button>
        <button type="submit" asp-action="AutoresExcel" class="btn btn-success">Exportar a Excel</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay autores que coincidan con los filtros.</div>
}
else
{
    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Nacionalidad</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var autor in Model)
                    {
                        <tr>
                            <td>@autor.Id</td>
                            <td>@autor.Nombres</td>
                            <td>@autor.Apellidos</td>
                            <td><span class="badge bg-secondary">@autor.Nacionalidad</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
<p class="text-muted mt-2">Total de autores: @Model.Count</p>
