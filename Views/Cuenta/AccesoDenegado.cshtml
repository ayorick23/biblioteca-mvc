@{
    ViewData["Title"] = "Acceso denegado";
}

@* Semana 12: mensaje cuando el usuario no tiene autorización *@
<div class="text-center mt-5">
    <div class="display-1">🔒</div>
    <h1 class="mt-3">Acceso denegado</h1>
    <p class="text-muted">
        No tiene autorización para realizar esta operación.<br />
        Solo los usuarios con rol <strong>Administrador</strong> pueden agregar, editar o eliminar libros.
    </p>
    <a asp-controller="Libros" asp-action="Index" class="btn btn-primary">Volver a Libros</a>
</div>
